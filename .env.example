# --- Model ---
LLEV_ENGINE=llama                 # llama | fake (no model, for dev)
LLEV_MODEL=qwen3-1.7b             # registry key (python scripts/download_model.py --list)
# LLEV_MODEL_PATH=/models/custom.gguf   # custom GGUF instead of a registry key
# LLEV_TEMPLATE=chatml                  # required with a custom GGUF
LLEV_N_CTX=8192
LLEV_N_GPU_LAYERS=0               # -1 on Apple Silicon / CUDA to offload everything
# LLEV_N_THREADS=4

# --- Escalation (optional bigger model for low-confidence answers) ---
LLEV_ESCALATE_MODEL=gemma3-4b     # best measured escalation model (bench.md)
LLEV_ESCALATE_THRESHOLD=0.6

# --- Smartness ---
LLEV_DEBIAS_PERMUTATIONS=2
LLEV_FEWSHOT_K=3

# --- API ---
LLEV_API_KEYS=change-me           # comma-separated
LLEV_PORT=8088

# --- Storage ---
LLEV_MODELS_DIR=models
LLEV_DATA_DIR=data
LLEV_LOG_STATE=true
